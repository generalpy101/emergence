# Any OpenAI-compatible chat completions endpoint.
# Defaults target a local Ollama server (ollama serve exposes /v1).
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=llama3.1:8b

# Slow local servers: generation timeout in seconds (default 900).
# LLM_TIMEOUT_S=900

# Server-specific request fields merged into every call. Example: suppress
# Qwen3 thinking on oMLX/vLLM to cut generation time:
# LLM_EXTRA_BODY_JSON={"chat_template_kwargs":{"enable_thinking":false}}
